# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Required. Local MongoDB or a MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/agented

# Required. At least 16 characters. Use a real random value, not the example.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Extra origins allowed to call the API, comma-separated.
# The Vite dev server (5173) is already allowed by default - you only need
# this if you serve the client from somewhere else. Set it to where the
# BROWSER loads the client from, which is 5173 in development, not 3000.
CLIENT_ORIGIN=http://localhost:5173

# Optional. Daily AI calls allowed per student. Defaults to 250.
AI_DAILY_CALL_LIMIT=250

# ── AI providers ──────────────────────────────────────────────────────────
# Required for the tutor, assessments and diagrams. Free tier:
# https://console.groq.com
GROQ_API_KEY=

# Optional. Tried first, with Groq as the fallback when quota is exhausted.
# https://aistudio.google.com
GEMINI_API_KEY=

# Optional: comma-separated extra Gemini API keys (rotated when the primary
# key's quota is exhausted).
GEMINI_EXTRA_KEYS=

# ── Demo mode (optional) ────────────────────────────────────────────────────
# Set to 1 to run the WHOLE app with no AI key at all: the tutor, assessments
# and the progress pipeline all answer from a deterministic local stand-in, so
# you can demo or verify the project before signing up for a provider key.
# Every such reply says on-screen that it is offline, so it can never be
# mistaken for the real model.
#
# Refuses to activate when NODE_ENV=production, always. A deploy with a missing
# key must show an honest error, not a fabricated answer to a real student.
#
# Leave unset for normal use. This is a review/demo convenience, not a mode to
# ship with.
# ALLOW_OFFLINE_AI=1